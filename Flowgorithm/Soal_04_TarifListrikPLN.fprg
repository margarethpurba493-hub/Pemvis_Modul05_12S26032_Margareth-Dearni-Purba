<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Soal_04_TarifListrikPLN"/>
        <attribute name="authors" value="marga"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-09 02:50:35 PM"/>
        <attribute name="created" value="bWFyZ2E7TUFSR0FSRVRIOzIwMjYtMTAtMDk7MDE6NTc6MzAgUE07MjQ2Nw=="/>
        <attribute name="edited" value="bWFyZ2E7TUFSR0FSRVRIOzIwMjYtMTAtMDk7MDI6NTA6MzUgUE07MTsyNTc0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="golongan, dayaVA" type="Integer" array="False" size=""/>
            <declare name="kWh, t1, t2, t3, persenPPJ, kVA, biaya, biayaminimum, ppj, total" type="Real" array="False" size=""/>
            <assign variable="t1" expression="1000"/>
            <assign variable="t2" expression="1500"/>
            <assign variable="t3" expression="2000"/>
            <output expression="&quot;golongan (1=R1, 2=R2, 3=R3):&quot;" newline="True"/>
            <input variable="golongan"/>
            <output expression="&quot;daya VA :&quot;" newline="True"/>
            <input variable="dayaVA"/>
            <output expression="&quot;pemakaian kWh:&quot;" newline="True"/>
            <input variable="kWh"/>
            <if expression="kWh &lt;0">
                <then>
                    <output expression="&quot;kWh tidak boleh negatif&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="(golongan == 1 AND dayaVA ==900) OR (golongan ==2 AND (dayaVA &gt;= 1300 AND dayaVA &lt;=2200)) OR (golongan== 3 AND dayaVA &gt;=3500)">
                        <then>
                            <if expression="golongan== 3">
                                <then>
                                    <assign variable="persenPPJ" expression="0.08"/>
                                </then>
                                <else>
                                    <assign variable="persenPPJ" expression="0.05"/>
                                </else>
                            </if>
                            <if expression="kWh &lt;= 50">
                                <then>
                                    <assign variable="biaya" expression="kWh * t1"/>
                                </then>
                                <else>
                                    <if expression="kWh &lt;= 150">
                                        <then>
                                            <assign variable="biaya" expression="50*t1+(kWh-50)*t2"/>
                                        </then>
                                        <else>
                                            <assign variable="biaya" expression="50*t1+100*t2(kWh-150)*t3"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                            <assign variable="kVA" expression="dayaVA/1000"/>
                            <assign variable="biayaminimum" expression="40*kVA*t1"/>
                            <if expression="biaya&lt;biayaminimum">
                                <then>
                                    <assign variable="biaya" expression="biayaminimum"/>
                                </then>
                                <else/>
                            </if>
                            <assign variable="ppj" expression="biaya*persenPPJ"/>
                            <assign variable="total" expression="biaya+ppj"/>
                            <output expression="&quot;biaya awal :Rp&quot; &amp; ToString (biaya)" newline="True"/>
                            <output expression="&quot;pajak PPJ: Rp&quot; &amp; ToString (ppj)" newline="True"/>
                            <output expression="&quot;total tagihan di akhir: Rp&quot; &amp; ToString (total)" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;golongan tidak valid&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
